# Copy this file to .env and replace all sample values before launching.
VITE_API_URL=http://localhost:8080
DB_USERNAME=teksher
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
JWT_EXPIRATION_MINUTES=480

# Optional: enables document summaries through the OpenAI API. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Put the deployed Netlify URL here when the frontend is hosted.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Only these domains may be polled by the automatic source monitor. Add an official domain only after verifying it.
MONITOR_ALLOWED_HOSTS=publication.pravo.gov.ru,pravo.gov.ru,docs.eaeunion.org,eec.eaeunion.org,cbd.minjust.gov.kg,minjust.gov.kg,gov.kg
